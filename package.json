{
	"name": "facetshot",
	"version": "0.1.0",
	"description": "Screenshots of your app's screens on several devices and display settings at once, with a list of what looks broken and what the app logged. For people and AI coding agents (command line, MCP server, Agent Skill).",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Sung-eon/Facetshot.git"
	},
	"homepage": "https://github.com/Sung-eon/Facetshot#readme",
	"bugs": {
		"url": "https://github.com/Sung-eon/Facetshot/issues"
	},
	"keywords": [
		"screenshots",
		"visual testing",
		"playwright",
		"mcp",
		"ai agents",
		"agent skill",
		"electron",
		"tauri",
		"ios simulator",
		"swiftui",
		"flutter",
		"storybook"
	],
	"type": "module",
	"files": [
		"src",
		"skills",
		"schema",
		"FacetshotRunner",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"facetshot": "./src/cli.ts",
		"fshot": "./src/cli.ts"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"test": "bun test test",
		"check": "bun --bun tsc --noEmit -p .",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.2",
		"pixelmatch": "8.0.0",
		"playwright": "1.64.1",
		"pngjs": "7.0.0",
		"yaml": "2.9.1",
		"zod": "4.6.7"
	},
	"optionalDependencies": {
		"axe-core": "4.14.0"
	},
	"devDependencies": {
		"@types/bun": "1.4.4",
		"@types/pngjs": "6.0.5",
		"prettier": "3.9.10",
		"typescript": "6.0.3"
	}
}
