{
  "default-configuration": "Debug",
  "configurations": ["Debug"],
  "localizations": { "development": "en", "supported": ["Base"] },
  "files": [
    { "kind": "folder", "path": "FacetshotHost", "target-membership": [ "FacetshotHost" ] },
    { "kind": "folder", "path": "FacetshotRunner", "target-membership": [ "FacetshotRunner" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/FacetshotHost.app", "id": "000000000000000000000220", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/FacetshotRunner.xctest", "id": "000000000000000000000221", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "FacetshotHost",
      "id": "000000000000000300000000",
      "product": "Products/FacetshotHost.app",
      "product-type": "application",
      "build-phases": ["compile-sources", "frameworks", "resources"],
      "build-settings": {
        "CODE_SIGNING_ALLOWED": "NO",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortraitUpsideDown",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.facetshot.host",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphonesimulator",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
    {
      "name": "FacetshotRunner",
      "id": "000000000000000400000000",
      "product": "Products/FacetshotRunner.xctest",
      "product-type": "bundle.ui-testing",
      "dependencies": [ { "target": "FacetshotHost" } ],
      "build-phases": ["compile-sources", "frameworks", "resources"],
      "build-settings": {
        "CODE_SIGNING_ALLOWED": "NO",
        "CURRENT_PROJECT_VERSION": "1",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": "@loader_path/Frameworks",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.facetshot.runner",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphonesimulator",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "FacetshotHost",
      },
    },
  ],
}
