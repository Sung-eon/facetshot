# The examples' installed dependencies and build output (each example installs its own).
examples/*/node_modules
examples/*/dist
examples/*/storybook-static
examples/*/src-tauri/target
examples/*/src-tauri/gen
examples/*/.build
examples/*/.swiftpm
# Flutter's own tool and build output.
examples/*/.dart_tool
examples/*/build
# SwiftPM, for FacetshotKit built from this folder.
.build/
.swiftpm/
Package.resolved

# Installed dependencies and facetshot's own output when run from this folder.
node_modules/
.facetshot/
.out/
.DS_Store

# The docs site's dependencies, build output and generated content (site/.gitignore lists the rest).
site/node_modules/
site/dist/
site/.astro/
