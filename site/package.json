{
	"name": "facetshot-site",
	"private": true,
	"type": "module",
	"scripts": {
		"sync": "bun scripts/sync-docs.ts",
		"dev": "bun scripts/sync-docs.ts && bun --bun astro dev",
		"build": "bun scripts/sync-docs.ts && bun --bun astro build",
		"preview": "bun --bun astro preview",
		"deploy": "bun run build && bun scripts/deploy.ts",
		"og": "bun scripts/og.ts"
	},
	"dependencies": {
		"@astrojs/starlight": "^0.42.11",
		"astro": "^7.4.11",
		"sharp": "^0.35.5"
	}
}
